  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1143.0",
    "@aws-sdk/client-lambda": "3.1143.0",
    "@aws-sdk/client-sns": "3.1143.0",
    "@aws-sdk/lib-dynamodb": "3.1143.0",
    "@leanstacks/lambda-utils": "0.9.0",
    "zod": "4.6.5"
  }
}
