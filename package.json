{
  "name": "@leanstacks/lambda-starter",
  "version": "1.4.0-alpha.1",
  "description": "A starter project for Lambda functions using Node.js, TypeScript, and a curated technology stack for optimal performance, reliability, and maintainability.",
  "keywords": [
    "aws",
    "lambda",
    "typescript",
    "node"
  ],
  "homepage": "https://github.com/leanstacks/lambda-starter#readme",
  "bugs": {
    "url": "https://github.com/leanstacks/lambda-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leanstacks/lambda-starter.git"
  },
  "license": "MIT",
  "author": "Matthew Warman",
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf cdk.out coverage dist",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "jest --coverage=false --silent --verbose",
    "test:coverage": "jest --coverage --silent --verbose",
    "test:watch": "jest --watch",
    "local:start": "docker-compose up -d",
    "local:stop": "docker-compose down",
    "local:logs": "docker-compose logs -f localstack",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1143.0",
    "@aws-sdk/client-lambda": "3.1143.0",
    "@aws-sdk/client-sns": "3.1143.0",
    "@aws-sdk/lib-dynamodb": "3.1143.0",
    "@leanstacks/lambda-utils": "0.9.0",
    "zod": "4.6.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
