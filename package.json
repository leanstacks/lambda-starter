{
  "name": "@leanstacks/lambda-starter",
  "version": "1.4.0",
  "description": "A starter project for Lambda functions using Node.js, TypeScript, and a curated technology stack for optimal performance, reliability, and maintainability.",
  "keywords": [
    "aws",
    "lambda",
    "typescript",
    "node"
  ],
  "homepage": "https://github.com/leanstacks/lambda-starter#readme",
  "bugs": {
    "url": "https://github.com/leanstacks/lambda-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leanstacks/lambda-starter.git"
  },
  "license": "MIT",
  "author": "Matthew Warman",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rimraf coverage",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:watch": "vitest",
    "local:start": "docker-compose up -d",
    "local:stop": "docker-compose down",
    "local:logs": "docker-compose logs -f localstack",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.3",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
