{
  "name": "lambda-starter",
  "version": "0.4.0",
  "description": "A starter project for Lambda functions using Node.js and TypeScript.",
  "keywords": [
    "aws",
    "lambda",
    "typescript",
    "node"
  ],
  "homepage": "https://github.com/leanstacks/lambda-starter#readme",
  "bugs": {
    "url": "https://github.com/leanstacks/lambda-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leanstacks/lambda-starter.git"
  },
  "license": "MIT",
  "author": "Matthew Warman",
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf cdk.out coverage dist",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "jest --coverage=false --silent --verbose",
    "test:coverage": "jest --coverage --silent --verbose",
    "test:watch": "jest --watch",
    "local:start": "docker-compose up -d",
    "local:stop": "docker-compose down",
    "local:logs": "docker-compose logs -f localstack",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.160",
    "@types/jest": "30.0.0",
    "@types/node": "25.0.10",
    "@typescript-eslint/eslint-plugin": "8.53.1",
    "@typescript-eslint/parser": "8.53.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.0.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "prettier": "3.8.1",
    "rimraf": "6.1.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.972.0",
    "@aws-sdk/client-lambda": "3.972.0",
    "@aws-sdk/client-sns": "3.972.0",
    "@aws-sdk/lib-dynamodb": "3.972.0",
    "@leanstacks/lambda-utils": "0.5.0",
    "zod": "4.3.5"
  }
}
